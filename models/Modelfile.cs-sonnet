FROM cs-sonnet
# Context window — the shared prompt now (with LifePath's 21-mode block made
# conditional in brain.js) runs ~3,464 tokens for a normal request, down from
# ~4,700. 4608 (1.125x the confirmed-fast 4096) gives real output headroom
# without repeating the earlier 6144-16384 regressions (35-60s+ responses on
# this 7.8GB-RAM hardware, vs. the 2-6s baseline).
PARAMETER num_ctx 4608
# Large batch for fast prefill
PARAMETER num_batch 512
# Full GPU offload — 2B fits in 4GB VRAM
PARAMETER num_gpu 99
# Temperature — balanced for career advice quality
PARAMETER temperature 0.7
PARAMETER top_p 0.9
# Lower repeat penalty — 2B is smart enough not to loop
PARAMETER repeat_penalty 1.08
# More output tokens — this is where we beat the defaults
PARAMETER num_predict 2048
PARAMETER stop "<|end|>"
PARAMETER stop "[DONE]"
