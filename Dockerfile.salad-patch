# Thin patch layer over the already-built owo1232011/careerstudiomax:latest.
# Fixes bugs found without a full 12.8GB rebuild:
#   1. salad-entrypoint.sh extracted the model backup to /root/.ollama
#      instead of /root/.ollama/models, so Ollama never saw the restored
#      models.
#   2. The Sept-3 backup predates the model rename — it holds cs-sonnet /
#      cs-haiku, so the entrypoint now `ollama cp`s them to the new names.
#   3. engine/vlm.js's vision-model match list still looked for 'llava',
#      which no longer matches the renamed 'cs-careerqueen' tag.
#   4. (2026-09-15) salad-entrypoint.sh blocked `exec node server.js` on
#      the entire ~2.1GB S3 model restore + a llava-phi3 pull, with no
#      timeout on either and `set -e` killing the whole container on any
#      failure -- Salad's TCP startup probe on port 3002 was reliably
#      exhausted before Node ever bound the port. The restore now runs as
#      its own background job (new file: scripts/salad-model-warmup.sh)
#      with its own bounded timeouts and non-fatal error handling; Node
#      starts immediately after Ollama's own base API responds.
#
# Build:  docker build -f Dockerfile.salad-patch -t owo1232011/careerstudiomax:latest .
# Push:   docker push owo1232011/careerstudiomax:latest
FROM owo1232011/careerstudiomax:latest

COPY scripts/salad-entrypoint.sh /app/scripts/salad-entrypoint.sh
COPY scripts/salad-model-warmup.sh /app/scripts/salad-model-warmup.sh
COPY engine/vlm.js /app/engine/vlm.js
COPY core/modelWarmupState.js /app/core/modelWarmupState.js
COPY server.js /app/server.js
RUN chmod +x /app/scripts/salad-entrypoint.sh /app/scripts/salad-model-warmup.sh

# ENTRYPOINT is inherited from the base image — unchanged.
