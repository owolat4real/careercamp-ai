FROM cs-haiku
# Context window — 0.6B handles 2048 well
# (With LifePath's 21-mode block now conditional in brain.js, a normal
# request's shared prompt runs ~3,464 tokens instead of ~4,700. 4608 gives a
# small real output margin without the earlier 8192+ regression — response
# time is dominated by prompt-processing cost on this hardware regardless of
# exact ctx size in this range, so a modest bump is the right tradeoff.)
PARAMETER num_ctx 4608
# Batch size for prompt processing — larger = faster prefill
PARAMETER num_batch 512
# Use all GPU layers — 0.6B fits entirely in 4GB VRAM
PARAMETER num_gpu 99
# Temperature — slightly lower for more consistent output
PARAMETER temperature 0.65
# Top-p — focused sampling for structured output
PARAMETER top_p 0.85
# Repeat penalty — prevents loops in small models
PARAMETER repeat_penalty 1.15
PARAMETER num_predict 1024
# Stop tokens
PARAMETER stop "```"
PARAMETER stop "<|end|>"
PARAMETER stop "[DONE]"
