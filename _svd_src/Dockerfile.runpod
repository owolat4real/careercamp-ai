# ══════════════════════════════════════════════════════════════════
# Self-hosted Stable Video Diffusion — RunPod Serverless GPU build
# The INTERNAL video model: cs_fixed/services/videoGen.js tries this
# endpoint first and only falls back to Stability AI's paid hosted API
# if this one is unconfigured, unreachable, or fails. Same rationale as
# _sadtalker_src/ and _xtts_src/: Serverless scales to zero between
# generations rather than billing for an idle GPU continuously.
# Deliberately a SEPARATE RunPod endpoint (own RUNPOD_SVD_ENDPOINT_ID)
# so an outage on this or either other handler never blocks the others.
# ══════════════════════════════════════════════════════════════════
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3-pip python3.10-dev \
    ffmpeg git wget curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/bin/python

# Second real bug on this same endpoint, reported directly by RunPod
# support after they tested the worker's actual machine: still 0/16
# completed after the CUDA 11.8 -> 12.1 fix below, because 12.1 (and its
# matching cu121 torch build) still doesn't ship kernels for every
# architecture in this endpoint's real assigned GPU pool -- their test
# machine reported CUDA 13.0, and RunPod's own guidance is 12.8+ since
# most of the platform's GPUs now run newer than that. Bumped to CUDA
# 12.8 base + matching cu128 torch build -- the exact same pairing
# _sadtalker_src/Dockerfile.runpod already runs successfully in this
# repo (see its comment: cu128 is the first stable line with compiled
# kernels for Blackwell/sm_120, and RunPod's scheduler doesn't reliably
# honor gpuTypeIds so the image needs to run on whatever GPU it lands
# on). torchaudio is dropped here (unlike SadTalker) since SVD is
# image-to-video only, no audio path.
#
# Real, honest caveat: diffusers==0.31.0's own setup.py declares
# "torch>=1.4,<2.5.0" as its tested range, so torch 2.7.1 is past what
# diffusers 0.31.0 officially claims to support. That pin only ships in
# the optional diffusers[torch] extra, not diffusers' bare
# install_requires, and requirements.txt below installs plain
# "diffusers==0.31.0" after torch is already present -- so this does
# NOT fail at pip-install time. The real risk is a runtime API-shape
# break, not a build failure. Given this endpoint is currently at 0/16
# successful jobs on the old CUDA 11.8/12.1 builds, and the
# from_pretrained() sanity check a few lines below already fails the
# build loudly on a genuine diffusers/torch incompatibility, this is a
# bounded, verifiable bet in the direction RunPod itself recommended --
# if the build-time check below ever fails with a diffusers/torch error
# (not a CUDA error), that's the real signal to upgrade diffusers
# instead of downgrading torch.
RUN pip install --no-cache-dir torch==2.7.1 torchvision==0.22.1 \
    --index-url https://download.pytorch.org/whl/cu128

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY _engine.py .
COPY runpod_handler.py .

# Bake the SVD-XT checkpoint (~10GB fp16) into the image at build time
# so the first request after a scale-to-zero cold start doesn't also pay
# for a fresh HuggingFace download — same rationale as _xtts_src's
# Dockerfile baking in the XTTS-v2 weights.
RUN python -c "\
import torch; \
from diffusers import StableVideoDiffusionPipeline; \
StableVideoDiffusionPipeline.from_pretrained('stabilityai/stable-video-diffusion-img2vid-xt', torch_dtype=torch.float16, variant='fp16')"

# Worker logs showed the container genuinely re-downloading component
# files from HuggingFace at runtime instead of using what was just
# baked in above — the cache wasn't being recognised as a hit for some
# reason (likely a revision-resolution check that from_pretrained()
# does over the network by default, even when local files exist,
# falling back to a fresh fetch here). On this account's connection
# (~100-300kB/s, observed in worker logs) that alone was enough to
# blow past RunPod's job timeout without ever finishing. Forcing
# offline mode makes it use ONLY the baked-in cache, no network
# involved — if the cache path is ever wrong, this fails immediately
# and loudly instead of silently re-downloading for minutes.
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

# No EXPOSE/HEALTHCHECK — RunPod Serverless workers pull jobs from
# RunPod's own queue rather than listening for inbound HTTP traffic.
CMD ["python", "runpod_handler.py"]
